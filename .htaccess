<IfModule mod_rewrite.c>
  RewriteEngine on
  
  # If the request is for the root, redirect it to /dist/
  RewriteRule ^$ dist/ [L]

  # If the request is not for a real file/folder, forward to /dist/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ dist/$1 [L]
</IfModule>
